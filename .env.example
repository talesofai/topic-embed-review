# 复制为 .env 后填写。绝不要在这里放用户完整登录态令牌 —— 审查只需要下面的 NIETA_DEV_PUBLISH_TOKEN(只读)。

NIETA_API_BASE=https://pre.api.talesofai.cn
NIETA_ACTIVITY_UUID=<要审的话题活动 uuid>

# 和创作者发布用同一个 dev-publish 令牌(app 内[生成开发令牌]获取,绑该活动、只读)。
# 它能列版本(versions 接口),OSS 产物公开可读、下载无需令牌;调不动任何写接口 / 上线(403)。
NIETA_DEV_PUBLISH_TOKEN=<dev-publish 令牌>

# 仅 pre 联调需要(pre 网关要求);prod 不要设。
NIETA_DEVELOP_PASS=1

# 被审内嵌页对应的 cohub 链接 —— space 或 session 皆可(session 会自动归一到其所属 space 定位源码):
#   space  : https://cohub.run/spaces/<spaceId>
#   session: https://cohub.run/spaces/<spaceId>/sessions/<sessionId>
# 审查必须结合源码(压缩产物可读性差),故此项为必需输入;命令行也可用 --space/--session/--cohub <url> 传。
COHUB_SESSION_URL=<https://cohub.run/spaces/xxx/sessions/xxx>
# 或只有 space 链接时填这个(二选一即可,SESSION 优先):
# COHUB_SPACE_URL=<https://cohub.run/spaces/xxx>
